{
  "expo": {
    "name": "Angkol",
    "slug": "angkol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.angkol.app"
    },
    "android": {
      "package": "com.angkol.app",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0F5D45",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "translucent": false
    },
    "web": {
      "favicon": "./assets/angkol-icon.png"
    },
    "scheme": "angkol",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Angkol uses your location to show nearby vehicles and share your trip position with your driver."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Angkol uses your photo library so you can set a profile picture or attach your driver's license.",
          "cameraPermission": "Angkol uses your camera so you can photograph your driver's license for review."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F5D45"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ]
    ]
  }
}
