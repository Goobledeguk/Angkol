{
  "expo": {
    "name": "Angkol",
    "slug": "angkol-static-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/angkol-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/angkol-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5D45"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5D45",
        "foregroundImage": "./assets/angkol-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/angkol-icon.png"
    },
    "scheme": "angkol-prototype",
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
