# Angkol live environment — only two services are used.
# Copy to .env and fill in real values. `.env` is git-ignored.

# Supabase: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Driver emulator (npm run emulate:drivers): approved tricycle driver TEST accounts.
# They really accept and complete bookings, so never use real drivers here.
# With supabase/seed.sql: EMULATOR_DRIVERS=driver1@angkol.test:Driver1!,driver2@angkol.test:Driver2!
EMULATOR_DRIVERS=
# Time multiplier (1 = real tricycle speed) and seconds to wait at pickup before starting.
EMULATOR_SPEED=4
EMULATOR_BOARD_WAIT=15
